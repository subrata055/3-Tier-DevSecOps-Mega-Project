      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"three-tier-app\"}[2m])) by (pod)",
          "legendFormat": "{{pod}} (Rx)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"three-tier-app\"}[2m])) by (pod)",
          "legendFormat": "{{pod}} (Tx)",
          "refId": "B"
        }
      ],
      "title": "Network I/O Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line" },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
